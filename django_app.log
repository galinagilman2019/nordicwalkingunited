DEBUG 2025-03-04 23:34:42,021 utils (0.000) INSERT INTO "core_eventpagecontent" ("event_id", "name", "content", "background", "position", "is_public") VALUES (16, 'about', '

<div style="text-align: center;">
	<h1>Free programming workshop for women</h1>
	<h2>Build your first website at EuroPython 2014 in Berlin!</h2>
	<a class="btn" href="#values">Learn more »</a>
</div>
', 'event/backgrounds/about1_OBM4CND.jpg', 0, true) RETURNING "core_eventpagecontent"."id"; args=(16, 'about', '\n\n<div style="text-align: center;">\n\t<h1>Free programming workshop for women</h1>\n\t<h2>Build your first website at EuroPython 2014 in Berlin!</h2>\n\t<a class="btn" href="#values">Learn more »</a>\n</div>\n', 'event/backgrounds/about1_OBM4CND.jpg', Int4(0), True); alias=default
DEBUG 2025-03-04 23:34:42,021 utils (0.000) INSERT INTO "core_eventpagecontent" ("event_id", "name", "content", "background", "position", "is_public") VALUES (16, 'values', '

<div class="row">
	<div class="col-md-6">
		<h3>Django Girls</h3>
		<p>
			If you are a woman and want to learn how to make websites, we have good news for you: we are holding a one-day workshop for beginners!
	    </p>

		<p>
			It will take place on <strong>DAY, MONTH, YEAR</strong> at <strong>VENUE</strong> in <strong>CITY</strong>.
		</p>

		<p>
          We believe the IT industry will greatly benefit from bringing more women into technology. We want to give you an opportunity to learn how to program and become one of us &ndash; women programmers!
		</p>

		<p>
          Workshops are free of charge and if you cannot afford coming to CITY but are very motivated to learn and then share your knowledge with others, we may have some funds to help you out with your travel costs and accommodation. Don''t wait too long: you can apply for the workshop only until <strong>DATE</strong>!
	 	</p>
	 </div>

	 <div class="col-md-6">
	 	<h3>Apply for the workshop!</h3>
	 	<p>
          If you are a woman, know English and have a laptop, you can apply for our event! You don''t need to know any technical stuff &ndash; our workshop is for people who are new to programming.
	 	</p>

	 	<p>
	 		As a workshop attendee you will:
	 		<ul>
	 			<li>
                    attend a one-day Django workshop during which you will create your first website
                </li>
	 			<li>be fed by us: during our event, food is provided</li>
	 		</ul>
	 	</p>

	 	<p>
	 		We have space only for XX people, so make sure to fill out the form very carefully!
	 	</p>
	 </div>
</div>', '', 1, true) RETURNING "core_eventpagecontent"."id"; args=(16, 'values', '\n\n<div class="row">\n\t<div class="col-md-6">\n\t\t<h3>Django Girls</h3>\n\t\t<p>\n\t\t\tIf you are a woman and want to learn how to make websites, we have good news for you: we are holding a one-day workshop for beginners!\n\t    </p>\n\n\t\t<p>\n\t\t\tIt will take place on <strong>DAY, MONTH, YEAR</strong> at <strong>VENUE</strong> in <strong>CITY</strong>.\n\t\t</p>\n\n\t\t<p>\n          We believe the IT industry will greatly benefit from bringing more women into technology. We want to give you an opportunity to learn how to program and become one of us &ndash; women programmers!\n\t\t</p>\n\n\t\t<p>\n          Workshops are free of charge and if you cannot afford coming to CITY but are very motivated to learn and then share your knowledge with others, we may have some funds to help you out with your travel costs and accommodation. Don\'t wait too long: you can apply for the workshop only until <strong>DATE</strong>!\n\t \t</p>\n\t </div>\n\n\t <div class="col-md-6">\n\t \t<h3>Apply for the workshop!</h3>\n\t \t<p>\n          If you are a woman, know English and have a laptop, you can apply for our event! You don\'t need to know any technical stuff &ndash; our workshop is for people who are new to programming.\n\t \t</p>\n\n\t \t<p>\n\t \t\tAs a workshop attendee you will:\n\t \t\t<ul>\n\t \t\t\t<li>\n                    attend a one-day Django workshop during which you will create your first website\n                </li>\n\t \t\t\t<li>be fed by us: during our event, food is provided</li>\n\t \t\t</ul>\n\t \t</p>\n\n\t \t<p>\n\t \t\tWe have space only for XX people, so make sure to fill out the form very carefully!\n\t \t</p>\n\t </div>\n</div>', '', Int4(1), True); alias=default
DEBUG 2025-03-04 23:34:42,022 utils (0.000) INSERT INTO "core_eventpagecontent" ("event_id", "name", "content", "background", "position", "is_public") VALUES (16, 'apply', '

<div class="row">
	<div class="col-md-7 col-md-offset-5">
		<h2>Applications are now open!</h2>
		<p>
			Application process closes on July 23rd and you''ll be informed about acceptance or rejection by July 28th (or sooner)!
		</p>

		<a class="btn" href="apply">Register</a>
	</div>
</div>', 'event/backgrounds/apply_RcWwu83.jpg', 2, true) RETURNING "core_eventpagecontent"."id"; args=(16, 'apply', '\n\n<div class="row">\n\t<div class="col-md-7 col-md-offset-5">\n\t\t<h2>Applications are now open!</h2>\n\t\t<p>\n\t\t\tApplication process closes on July 23rd and you\'ll be informed about acceptance or rejection by July 28th (or sooner)!\n\t\t</p>\n\n\t\t<a class="btn" href="apply">Register</a>\n\t</div>\n</div>', 'event/backgrounds/apply_RcWwu83.jpg', Int4(2), True); alias=default
DEBUG 2025-03-04 23:34:42,023 utils (0.000) INSERT INTO "core_eventpagecontent" ("event_id", "name", "content", "background", "position", "is_public") VALUES (16, 'faq', '

<div class="row">
	<div class="col-md-4">
		<p>
			<b>Do I need to know anything about websites or programming?</b>
		</p>
		<p>
          No! Workshops are for beginners. You don’t need to know anything about it. However, if you have a little bit of technical knowledge (i.e. you know what HTML or CSS are) you still can apply!
		</p>
	</div>

	<div class="col-md-4">
		<p>
			<b>I am not living in Germany, can I attend?</b>
		</p>
		<p>
          Of course! Workshops will be in English, so if you have no troubles with speaking and understanding English - you should apply. If you need financial aid to get to Berlin or you need assistance with booking flights or hotel in Berlin - let us know. We are willing to help you!
		</p>
	</div>

	<div class="col-md-4">
		<p>
			<b>Should I bring my own laptop?</b>
		</p>
		<p>
          Yes. We have no hardware, so we expect you to bring your computer with you. It is also important for us that you will take home everything you’ll write and create during workshops.
		</p>
	</div>
</div>

<div class="row" style="margin-top: 30px">
	<div class="col-md-4">
		<p>
			<b>Do I need to have something installed on my laptop?</b>
		</p>
		<p>
          It would be helpful to have Django installed before workshops, but wouldn''t expect you to install anything on your own.We will make sure that one of our coaches will help you out with this task.
		</p>
	</div>

	<div class="col-md-4">
		<p>
			<b>Is EuroPython conference good for a total beginner?</b>
		</p>
		<p>
          As a workshop attendee you will get a free ticket to EuroPython - conference for Python programmers. Even though you are new to programming,conference is a good place to meet many interesting people in the industry and find inspiration.
		</p>
	</div>

	<div class="col-md-4">
		<p><b>Is food provided?</b></p>
		<p>Yes. Thanks to EuroPython, snacks and lunch will be served during workshops.</p>
	</div>
</div>', '', 3, true) RETURNING "core_eventpagecontent"."id"; args=(16, 'faq', '\n\n<div class="row">\n\t<div class="col-md-4">\n\t\t<p>\n\t\t\t<b>Do I need to know anything about websites or programming?</b>\n\t\t</p>\n\t\t<p>\n          No! Workshops are for beginners. You don’t need to know anything about it. However, if you have a little bit of technical knowledge (i.e. you know what HTML or CSS are) you still can apply!\n\t\t</p>\n\t</div>\n\n\t<div class="col-md-4">\n\t\t<p>\n\t\t\t<b>I am not living in Germany, can I attend?</b>\n\t\t</p>\n\t\t<p>\n          Of course! Workshops will be in English, so if you have no troubles with speaking and understanding English - you should apply. If you need financial aid to get to Berlin or you need assistance with booking flights or hotel in Berlin - let us know. We are willing to help you!\n\t\t</p>\n\t</div>\n\n\t<div class="col-md-4">\n\t\t<p>\n\t\t\t<b>Should I bring my own laptop?</b>\n\t\t</p>\n\t\t<p>\n          Yes. We have no hardware, so we expect you to bring your computer with you. It is also important for us that you will take home everything you’ll write and create during workshops.\n\t\t</p>\n\t</div>\n</div>\n\n<div class="row" style="margin-top: 30px">\n\t<div class="col-md-4">\n\t\t<p>\n\t\t\t<b>Do I need to have something installed on my laptop?</b>\n\t\t</p>\n\t\t<p>\n          It would be helpful to have Django installed before workshops, but wouldn\'t expect you to install anything on your own.We will make sure that one of our coaches will help you out with this task.\n\t\t</p>\n\t</div>\n\n\t<div class="col-md-4">\n\t\t<p>\n\t\t\t<b>Is EuroPython conference good for a total beginner?</b>\n\t\t</p>\n\t\t<p>\n          As a workshop attendee you will get a free ticket to EuroPython - conference for Python programmers. Even though you are new to programming,conference is a good place to meet many interesting people in the industry and find inspiration.\n\t\t</p>\n\t</div>\n\n\t<div class="col-md-4">\n\t\t<p><b>Is food provided?</b></p>\n\t\t<p>Yes. Thanks to EuroPython, snacks and lunch will be served during workshops.</p>\n\t</div>\n</div>', '', Int4(3), True); alias=default
DEBUG 2025-03-04 23:34:42,024 utils (0.000) INSERT INTO "core_eventpagecontent" ("event_id", "name", "content", "background", "position", "is_public") VALUES (16, 'coach', '

<div class="row">
	<div class="col-md-6">
		<h2>Be a Mentor!</h2>
		<p>
        
          We would be delighted if you would like to join us as a mentor! <a href="/en/contact/">Contact us</a> if you''re interested ❤️
		</p>
	</div>

	<div class="col-md-6">
		<h2>Django Girls</h2>
		<p>
          This workshop is a part of bigger initiative: <a href="https://djangogirls.org/">Django Girls</a>. It is a non-profit organization and events are organized by volunteers in different places of the world.
		</p>
		<p>
          To see the source for the program find us on Github: <a href="https://github.com/DjangoGirls/">github.com/DjangoGirls</a>.
		</p>
		<p>
          If you want to bring Django Girls to your city, <a href="/en/contact/">drop us a line</a>
		</p>
	</div>
</div>
', 'event/backgrounds/coach2_pHiGxfg.jpg', 4, true) RETURNING "core_eventpagecontent"."id"; args=(16, 'coach', '\n\n<div class="row">\n\t<div class="col-md-6">\n\t\t<h2>Be a Mentor!</h2>\n\t\t<p>\n        \n          We would be delighted if you would like to join us as a mentor! <a href="/en/contact/">Contact us</a> if you\'re interested ❤️\n\t\t</p>\n\t</div>\n\n\t<div class="col-md-6">\n\t\t<h2>Django Girls</h2>\n\t\t<p>\n          This workshop is a part of bigger initiative: <a href="https://djangogirls.org/">Django Girls</a>. It is a non-profit organization and events are organized by volunteers in different places of the world.\n\t\t</p>\n\t\t<p>\n          To see the source for the program find us on Github: <a href="https://github.com/DjangoGirls/">github.com/DjangoGirls</a>.\n\t\t</p>\n\t\t<p>\n          If you want to bring Django Girls to your city, <a href="/en/contact/">drop us a line</a>\n\t\t</p>\n\t</div>\n</div>\n', 'event/backgrounds/coach2_pHiGxfg.jpg', Int4(4), True); alias=default
DEBUG 2025-03-04 23:34:42,025 utils (0.001) INSERT INTO "core_eventpagecontent" ("event_id", "name", "content", "background", "position", "is_public") VALUES (16, 'partners', '

<h3>Sponsors</h3>

<p>
    
    We couldn''t be here without the support from amazing people and organizations who donated money, knowledge and time to help us make this a reality. If you want to contribute and support our goal, <a href="/en/contact/">please get it touch</a>
</p>', '', 5, true) RETURNING "core_eventpagecontent"."id"; args=(16, 'partners', '\n\n<h3>Sponsors</h3>\n\n<p>\n    \n    We couldn\'t be here without the support from amazing people and organizations who donated money, knowledge and time to help us make this a reality. If you want to contribute and support our goal, <a href="/en/contact/">please get it touch</a>\n</p>', '', Int4(5), True); alias=default
DEBUG 2025-03-04 23:34:42,026 utils (0.001) INSERT INTO "core_eventpagecontent" ("event_id", "name", "content", "background", "position", "is_public") VALUES (16, 'footer', '

<div class="container">
	<div class="row social">
		<div class="col-md-6 col-xs-6 text-center">
