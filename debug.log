(0.004) UPDATE "core_nwu_manual" SET "title" = 'Important: What to Do If a Participant Feels Unwell During an Event', "slug" = 'about-nordic-walking-what-to-do-if-a-participant-f', "audience" = 'team', "order" = 8, "table_title" = '', "body" = '<p>&nbsp;</p><section id="nwu-unwell-guidelines"><p>As an NWU event Organizer and Host, your first responsibility is the safety and wellbeing of your group. If a participant becomes unwell or there is a possible emergency during a walk, follow the steps below.</p><h3>1. Stay Calm and Stop the Group</h3><ul><li>Stay calm - your calmness reassures everyone.</li><li>Stop the group in a safe location away from traffic, water edges, or hazards.</li></ul><h3>2. Check In With the Person</h3><p>Approach gently and ask:</p><ul><li>“How are you feeling?”</li><li>“Are you dizzy, cold, overheated, short of breath, or in pain?”</li></ul><p>Observe for warning signs:</p><ul><li>Pale, flushed, sweaty, shivering, or weak</li><li>Trouble speaking or confusion</li><li>Difficulty breathing</li><li>Chest pain, severe headache, fainting, or inability to stand/walk</li></ul><p><strong>If severe symptoms are present, treat it as an emergency and call your local emergency services immediately.</strong></p><h3>3. Decide: Rest, Turn Back, or Call Emergency Services</h3><h4>a) Mild symptoms</h4><ul><li>Move the person to a more comfortable environment (shade, shelter, or away from wind).</li><li>Adjust clothing: loosen layers in heat, add warmth in cold.</li><li>Offer small sips of water if they are fully awake and able to drink.</li><li>Encourage slow breathing and rest.</li></ul><p>After resting, ask whether they want to:</p><ul><li>Rest longer,</li><li>Walk back slowly, or</li><li>Continue only if fully recovered.</li></ul><h4>b) Symptoms do not improve</h4><ul><li>Do <strong>not</strong> leave the person alone.</li><li>End their participation for the day.</li><li>Ask a trusted participant to either lead the group back or stay with the group while you stay with the unwell person.</li><li>If in doubt, call local emergency services.</li></ul><h4>c) Call emergency services immediately if you notice:</h4><ul><li>Chest pain or severe difficulty breathing</li><li>Sudden confusion or inability to communicate</li><li>Weakness or numbness on one side of the body</li><li>Loss of consciousness or repeated fainting</li><li>Extremely hot or extremely cold body temperature</li><li>Seizures</li><li>Symptoms that rapidly worsen</li></ul><p><strong>When unsure - always choose to call for help.</strong></p><h3>4. While Waiting for Help</h3><ul><li>Stay with the person at all times.</li><li>Keep them warm or gently cool them depending on the situation.</li><li>Reassure them with a calm, steady voice.</li><li>Follow all instructions given by the emergency operator.</li><li>If appropriate, notify their emergency contact.</li></ul><h3>5. Managing the Rest of the Group</h3><ul><li>Explain calmly that someone is unwell and you are assisting them.</li><li>Ask a responsible participant to safely lead the group back if needed.</li><li>Never send the group back alone without a leader.</li><li>If safer, keep the entire group together until help arrives.</li></ul><h3>6. After the Incident</h3><ul><li>Record the date, time, location, and what you observed.</li><li>Document all actions you took.</li><li>Note whether emergency services were involved.</li><li>Notify NWU leadership through the <strong>CONTACT US</strong> tab.</li><li>Do not share medical details with the group or online.</li></ul><h3>7. Important Notes</h3><ul><li>NWU Organizers and Hosts are not expected to provide medical treatment.</li><li><p>Your responsibilities are:</p><ul><li>Keep the group safe,</li><li>Stay with the unwell person,</li><li>Call local emergency services when needed,</li><li><p>Inform NWU afterward.</p><p>&nbsp;</p></li></ul><p data-start="804" data-end="952">By acting thoughtfully and responsibly, you help create a safe, caring, and trusted environment for everyone in the Nordic Walking United community.</p><p data-start="954" data-end="1011" data-is-last-node="" data-is-only-node="">Thank you for leading with care, awareness, and heart. 🌿</p></li></ul></section><p>&nbsp;</p>', "created_at" = '2025-11-22 04:04:42.768376', "updated_at" = '2026-01-19 21:38:34.297871' WHERE "core_nwu_manual"."id" = 20; args=('Important: What to Do If a Participant Feels Unwell During an Event', 'about-nordic-walking-what-to-do-if-a-participant-f', 'team', 8, '', '<p>&nbsp;</p><section id="nwu-unwell-guidelines"><p>As an NWU event Organizer and Host, your first responsibility is the safety and wellbeing of your group. If a participant becomes unwell or there is a possible emergency during a walk, follow the steps below.</p><h3>1. Stay Calm and Stop the Group</h3><ul><li>Stay calm - your calmness reassures everyone.</li><li>Stop the group in a safe location away from traffic, water edges, or hazards.</li></ul><h3>2. Check In With the Person</h3><p>Approach gently and ask:</p><ul><li>“How are you feeling?”</li><li>“Are you dizzy, cold, overheated, short of breath, or in pain?”</li></ul><p>Observe for warning signs:</p><ul><li>Pale, flushed, sweaty, shivering, or weak</li><li>Trouble speaking or confusion</li><li>Difficulty breathing</li><li>Chest pain, severe headache, fainting, or inability to stand/walk</li></ul><p><strong>If severe symptoms are present, treat it as an emergency and call your local emergency services immediately.</strong></p><h3>3. Decide: Rest, Turn Back, or Call Emergency Services</h3><h4>a) Mild symptoms</h4><ul><li>Move the person to a more comfortable environment (shade, shelter, or away from wind).</li><li>Adjust clothing: loosen layers in heat, add warmth in cold.</li><li>Offer small sips of water if they are fully awake and able to drink.</li><li>Encourage slow breathing and rest.</li></ul><p>After resting, ask whether they want to:</p><ul><li>Rest longer,</li><li>Walk back slowly, or</li><li>Continue only if fully recovered.</li></ul><h4>b) Symptoms do not improve</h4><ul><li>Do <strong>not</strong> leave the person alone.</li><li>End their participation for the day.</li><li>Ask a trusted participant to either lead the group back or stay with the group while you stay with the unwell person.</li><li>If in doubt, call local emergency services.</li></ul><h4>c) Call emergency services immediately if you notice:</h4><ul><li>Chest pain or severe difficulty breathing</li><li>Sudden confusion or inability to communicate</li><li>Weakness or numbness on one side of the body</li><li>Loss of consciousness or repeated fainting</li><li>Extremely hot or extremely cold body temperature</li><li>Seizures</li><li>Symptoms that rapidly worsen</li></ul><p><strong>When unsure - always choose to call for help.</strong></p><h3>4. While Waiting for Help</h3><ul><li>Stay with the person at all times.</li><li>Keep them warm or gently cool them depending on the situation.</li><li>Reassure them with a calm, steady voice.</li><li>Follow all instructions given by the emergency operator.</li><li>If appropriate, notify their emergency contact.</li></ul><h3>5. Managing the Rest of the Group</h3><ul><li>Explain calmly that someone is unwell and you are assisting them.</li><li>Ask a responsible participant to safely lead the group back if needed.</li><li>Never send the group back alone without a leader.</li><li>If safer, keep the entire group together until help arrives.</li></ul><h3>6. After the Incident</h3><ul><li>Record the date, time, location, and what you observed.</li><li>Document all actions you took.</li><li>Note whether emergency services were involved.</li><li>Notify NWU leadership through the <strong>CONTACT US</strong> tab.</li><li>Do not share medical details with the group or online.</li></ul><h3>7. Important Notes</h3><ul><li>NWU Organizers and Hosts are not expected to provide medical treatment.</li><li><p>Your responsibilities are:</p><ul><li>Keep the group safe,</li><li>Stay with the unwell person,</li><li>Call local emergency services when needed,</li><li><p>Inform NWU afterward.</p><p>&nbsp;</p></li></ul><p data-start="804" data-end="952">By acting thoughtfully and responsibly, you help create a safe, caring, and trusted environment for everyone in the Nordic Walking United community.</p><p data-start="954" data-end="1011" data-is-last-node="" data-is-only-node="">Thank you for leading with care, awareness, and heart. 🌿</p></li></ul></section><p>&nbsp;</p>', '2025-11-22 04:04:42.768376', '2026-01-19 21:38:34.297871', 20); alias=default
