(0.009) UPDATE "core_nwu_manual" SET "title" = 'Step 3. How to Create Your Next Event', "slug" = '3-how-to-create-your-next-event', "audience" = 'team', "order" = 3, "table_title" = '', "body" = '<p style="margin:0 0 10px;"><strong>We’re so glad you made it here !</strong></p><p style="margin:0 0 10px;">Now that you’ve created your first event, the journey continues - it’s time to create even more wonderful walks!<strong> </strong>Through your energy and enthusiasm in organizing Nordic Walking events, you bring movement, health, and connection to your community - and create something truly meaningful.</p><p style="margin:0 0 16px;">You are now an <strong>Organizer / Moderator</strong> and <strong>Administrator</strong> for your group, and you have full access to the <strong>Admin Panel</strong> with permission to manage your group’s events.</p><p style="margin:0 0 16px;"><strong>To create your next event, please follow these simple steps:</strong></p><ol style="margin-bottom:0;margin-right:0;margin-top:0;padding:0;"><li style="margin-bottom:14px;margin-right:0;margin-top:0;"><p style="margin-left:22px;"><strong>Log in to the Admin Panel</strong><br>Click the Admin Panel link provided in your Approval email.<br>Log in using your <strong>email</strong> and <strong>password</strong>.</p><figure class="image"><img style="aspect-ratio:372/336;" src="/uploads/AdminPanelLogin_mgQs8Bm.jpg" width="372" height="336"></figure></li><li style="margin-bottom:14px;margin-right:0;margin-top:0;"><p style="margin-left:22px;"><strong>Admin Menu &amp; Events</strong><br>After logging in, you’ll see the main sidebar with the sections you have access to.<br>This is your organizer’s workspace - now it’s time to create your next event for your wonderful Nordic Walking group!<br>Look for the <strong>CORE</strong> section and find under it <strong>List of Events</strong>, where all your events are managed.</p><div class="nwu-imgph" style="background-color:#f2f2f2;border-radius:10px;margin:10px 0 14px 22px;padding:10px 12px;">Click any image below to enlarge (opens in a new tab):</div><figure class="image"><a href="/uploads/AdminPanelMainSections_eAIAyJq.jpg" target="_blank" rel="noopener noreferrer"><img style="aspect-ratio:884/396;cursor:zoom-in;" src="/uploads/AdminPanelMainSections_eAIAyJq.jpg" alt="Admin Panel – Main Sections" width="884" height="396"></a></figure></li><li style="margin-bottom:14px;margin-right:0;margin-top:0;"><p style="margin-left:22px;"><strong>Clone an Existing Event</strong><br>Click on <strong>List of Events</strong>.<br>On the right side, you’ll see your existing event(s).</p><figure class="image"><a href="/uploads/AdminPanelListOfEvents_1B9tW2c.jpg" target="_blank" rel="noopener noreferrer"><img style="aspect-ratio:1898/359;cursor:zoom-in;" src="/uploads/AdminPanelListOfEvents_1B9tW2c.jpg" alt="Admin Panel – List of Events" width="1898" height="359"></a></figure><p style="margin-left:22px;"><br>✔️ Check the box next to any event (for example: <i>“John Sunny Walkers Riga”</i>).<br>Then:</p><ul style="margin-bottom:0;margin-right:0;margin-top:8px;"><li><p style="margin-left:18px;">Open the <strong>Action</strong> dropdown</p></li><li><p style="margin-left:18px;">Select <strong>Clone Selected Events</strong></p></li><li><p style="margin-left:18px;">Click the <strong>Go</strong> button</p><figure class="image"><a href="/uploads/AdminPanelCloneEvent.jpg" target="_blank" rel="noopener noreferrer"><img style="aspect-ratio:692/429;cursor:zoom-in;" src="/uploads/AdminPanelCloneEvent.jpg" alt="Admin Panel – Clone Event" width="692" height="429"></a></figure></li></ul></li><li style="margin-bottom:14px;margin-right:0;margin-top:0;"><p style="margin-left:22px;"><strong>Find Your Cloned Event</strong><br>You will now see an exact copy of the event with <strong>“CLONE EVENT”</strong> added to its name (for example: <i>“John Sunny Walkers Riga CLONE EVENT”</i>).</p><figure class="image"><a href="/uploads/AdminPanelViewCLonedEventInList.jpg" target="_blank" rel="noopener noreferrer"><img style="aspect-ratio:717/518;cursor:zoom-in;" src="/uploads/AdminPanelViewCLonedEventInList.jpg" alt="Admin Panel – View Cloned Event in List" width="717" height="518"></a></figure></li><li style="margin-bottom:14px;margin-right:0;margin-top:0;"><p style="margin-left:22px;"><strong>Edit the Cloned Event</strong><br>Click on the <strong>CLONE EVENT</strong> and update all fields so they match your new event:</p><ul style="margin-bottom:0;margin-right:0;margin-top:8px;"><li><p style="margin-left:18px;">Date &amp; time</p></li><li><p style="margin-left:18px;">Location</p></li><li><p style="margin-left:18px;">Any other details</p></li><li><p style="margin-left:18px;">✏️ Don’t forget to update the event description text box</p></li></ul><p style="margin-left:22px;">Make it warm, welcoming, and inspiring - just like your group!</p><figure class="image"><a href="/uploads/AdminPanelViewCloneEvent.jpg" target="_blank" rel="noopener noreferrer"><img style="aspect-ratio:1877/640;cursor:zoom-in;" src="/uploads/AdminPanelViewCloneEvent.jpg" alt="Admin Panel – Cloned Event View" width="1877" height="640"></a></figure></li><li style="margin-bottom:14px;margin-right:0;margin-top:0;"><p style="margin-left:22px;"><strong>Save and Publish</strong><br>When everything looks right:</p><ul style="margin-bottom:0;margin-right:0;margin-top:8px;"><li><p style="margin-left:18px;">✔️ Check the <strong>Website is Ready</strong> checkbox</p></li><li><p style="margin-left:18px;">Click the <strong>SAVE</strong> button</p><figure class="image"><img style="aspect-ratio:473/241;" src="/uploads/AdminPanelWebsiteIsReady.jpg" width="473" height="241"></figure></li></ul></li><li style="margin-bottom:0;margin-right:0;margin-top:0;"><p style="margin-left:22px;"><strong>Your Event Is Live! 🎉</strong><br>Your event is now live on the NWU website!<br>You and your group co-organizers will receive a confirmation email shortly.<br><br>Have a wonderful time walking, connecting, and sharing joy with your group members.<br><strong>Thank you for being a heartbeat of Nordic Walking United!</strong></p></li></ol><p>&nbsp;</p>', "created_at" = '2026-01-03 21:23:40.147602', "updated_at" = '2026-01-19 21:29:15.175133' WHERE "core_nwu_manual"."id" = 29; args=('Step 3. How to Create Your Next Event', '3-how-to-create-your-next-event', 'team', 3, '', '<p style="margin:0 0 10px;"><strong>We’re so glad you made it here !</strong></p><p style="margin:0 0 10px;">Now that you’ve created your first event, the journey continues - it’s time to create even more wonderful walks!<strong> </strong>Through your energy and enthusiasm in organizing Nordic Walking events, you bring movement, health, and connection to your community - and create something truly meaningful.</p><p style="margin:0 0 16px;">You are now an <strong>Organizer / Moderator</strong> and <strong>Administrator</strong> for your group, and you have full access to the <strong>Admin Panel</strong> with permission to manage your group’s events.</p><p style="margin:0 0 16px;"><strong>To create your next event, please follow these simple steps:</strong></p><ol style="margin-bottom:0;margin-right:0;margin-top:0;padding:0;"><li style="margin-bottom:14px;margin-right:0;margin-top:0;"><p style="margin-left:22px;"><strong>Log in to the Admin Panel</strong><br>Click the Admin Panel link provided in your Approval email.<br>Log in using your <strong>email</strong> and <strong>password</strong>.</p><figure class="image"><img style="aspect-ratio:372/336;" src="/uploads/AdminPanelLogin_mgQs8Bm.jpg" width="372" height="336"></figure></li><li style="margin-bottom:14px;margin-right:0;margin-top:0;"><p style="margin-left:22px;"><strong>Admin Menu &amp; Events</strong><br>After logging in, you’ll see the main sidebar with the sections you have access to.<br>This is your organizer’s workspace - now it’s time to create your next event for your wonderful Nordic Walking group!<br>Look for the <strong>CORE</