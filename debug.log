(0.003) UPDATE "core_nwu_manual" SET "title" = 'How to manage your profile', "slug" = 'how-to-manage-your-profile', "audience" = 'team', "order" = 9, "table_title" = '', "body" = '<p>As an organizer, keeping your profile up to date helps us stay connected and keeps everything running smoothly for your events. Here’s how you can update it:</p><h4>Step 1: Log In</h4><ul><li><p>Select and click on any <strong>event</strong> on the website.</p><figure class="image"><img style="aspect-ratio:1355/522;" src="/uploads/FindEvent_of5hEFQ.jpg" width="1355" height="522"></figure><p>&nbsp;</p></li><li><strong>Log in</strong> to your account.</li></ul><figure class="image"><img style="aspect-ratio:598/95;" src="/uploads/LogInButton_bnO24AQ.jpg" width="598" height="95"></figure><h4>Step 2: Open Your Profile</h4><ul><li><p>In the top-right corner, click the green button with <strong>your name</strong> on it.</p><figure class="image"><img style="aspect-ratio:1454/224;" src="/uploads/JohnGreenButton.jpg" width="1454" height="224"></figure></li><li><p>In the next window, click the green <strong>"Profile"</strong> button. <i>Note: You can always return to the selected event by clicking the green <strong>"Go Back"</strong> button.</i></p><figure class="image"><img style="aspect-ratio:1455/540;" src="/uploads/ProfileButtonJohn_f702f32.jpg" width="1455" height="540"></figure></li></ul><h4>Step 3: Update Your Information</h4><ul><li>You can now edit any details you’d like to change.</li><li><p>When you’re done, click the green <strong>"Update Profile"</strong> button to save your changes. <i>Note: You can always return to the previous page by clicking the green <strong>"Cancel"</strong> button.</i></p><figure class="image"><img style="aspect-ratio:486/136;" src="/uploads/UpdateProfile_Ln7ngFx.jpg" width="486" height="136"></figure></li></ul><p><strong>Hurray!&nbsp;</strong><br>Your profile is now up to date - easy, quick, and done.<br>Enjoy your walks and see you on the trails! 🌿</p><p>&nbsp;</p>', "created_at" = '2026-01-05 01:51:33.891523', "updated_at" = '2026-01-19 21:41:32.325781' WHERE "core_nwu_manual"."id" = 32; args=('How to manage your profile', 'how-to-manage-your-profile', 'team', 9, '', '<p>As an organizer, keeping your profile up to date helps us stay connected and keeps everything running smoothly for your events. Here’s how you can update it:</p><h4>Step 1: Log In</h4><ul><li><p>Select and click on any <strong>event</strong> on the website.</p><figure class="image"><img style="aspect-ratio:1355/522;" src="/uploads/FindEvent_of5hEFQ.jpg" width="1355" height="522"></figure><p>&nbsp;</p></li><li><strong>Log in</strong> to your account.</li></ul><figure class="image"><img style="aspect-ratio:598/95;" src="/uploads/LogInButton_bnO24AQ.jpg" width="598" height="95"></figure><h4>Step 2: Open Your Profile</h4><ul><li><p>In the top-right corner, click the green button with <strong>your name</strong> on it.</p><figure class="image"><img style="aspect-ratio:1454/224;" src="/uploads/JohnGreenButton.jpg" width="1454" height="224"></figure></li><li><p>In the next window, click the green <strong>"Profile"</strong> button. <i>Note: You can always return to the selected event by clicking the green <strong>"Go Back"</strong> button.</i></p><figure class="image"><img style="aspect-ratio:1455/540;" src="/uploads/ProfileButtonJohn_f702f32.jpg" width="1455" height="540"></figure></li></ul><h4>Step 3: Update Your Information</h4><ul><li>You can now edit any details you’d like to change.</li><li><p>When you’re done, click the green <strong>"Update Profile"</strong> button to save your changes. <i>Note: You can always return to the previous page by clicking the green <strong>"Cancel"</strong> button.</i></p><figure class="image"><img style="aspect-ratio:486/136;" src="/uploads/UpdateProfile_Ln7ngFx.jpg" width="486" height="136"></figure></li></ul><p><strong>Hurray!&nbsp;</strong><br>Your profile is now up to date - easy, quick, and done.<br>Enjoy your walks and see you on the trails! 🌿</p><p>&nbsp;</p>', '2026-01-05 01:51:33.891523', '2026-01-19 21:41:32.325781', 32); alias=default
