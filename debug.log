(0.004) UPDATE "core_nwu_manual" SET "title" = 'Step 6. Use the Blog on the NWU Website', "slug" = 'step-5-use-blog-on-nwu-website', "audience" = 'team', "order" = 6, "table_title" = '', "body" = '<p>Thank you for being part of <strong>Nordic Walking United</strong>! Our blog is a wonderful place to stay connected with our growing global NWU family and to keep learning together.</p><p style="margin:16px 0 8px;"><strong>Here, our event organizers and hosts share:</strong></p><ul style="margin-bottom:14px;margin-right:0;margin-top:0;"><li><p style="margin-left:22px;">🌍 Stories and highlights from their Nordic Walks</p></li><li><p style="margin-left:22px;">📸 Photos and special moments from events</p></li><li><p style="margin-left:22px;">💬 Reflections, ideas, and helpful tips</p></li><li><p style="margin-left:22px;">🌱 Inspiration from their local communities and nature</p></li><li><p style="margin-left:22px;">🧘‍♀️ Simple educational insights on movement, well-being, mindfulness, and healthy living</p></li></ul><p style="margin:16px 0 8px;"><strong>By reading and leaving comments, you:</strong></p><ul style="margin-bottom:14px;margin-right:0;margin-top:0;"><li><p style="margin-left:22px;">💛 Encourage and support fellow walkers and organizers</p></li><li><p style="margin-left:22px;">🤝 Build meaningful connections across regions and countries</p></li><li><p style="margin-left:22px;">🌟 Share your thoughts, experiences, and words of kindness</p></li><li><p style="margin-left:22px;">🌎 Help strengthen our welcoming, global NWU community</p></li></ul><p style="margin:0 0 16px;">Your voice matters, and every comment helps keep our community warm, supportive, and connected. We’re so happy you’re here!</p><hr style="border-bottom-style:none;border-left-style:none;border-right-style:none;border-top:1px solid #d1d5db;margin:18px 0;"><h3 style="font-size:22px;margin:0 0 10px;">Below are the steps to use our Blog section:</h3><ol style="margin-bottom:0;margin-right:0;margin-top:0;"><li style="margin-bottom:12px;margin-right:0;margin-top:0;"><p style="margin-left:22px;"><strong>Find our Blog section on the NWU website</strong><br>Open our Blog page by clicking <strong>Resources → Our Blog</strong> in the main menu.</p><figure class="image"><img style="aspect-ratio:1312/317;" src="/uploads/Blog1_r42bHkF.jpg" width="1312" height="317"></figure></li><li style="margin-bottom:12px;margin-right:0;margin-top:0;"><p style="margin-left:22px;"><strong>Read through Blog posts:</strong><br>Click on any post you would like to read.</p><div style="background-color:#f9fafb;border-radius:10px;border:1px dashed #9ca3af;margin:10px 0 0;padding:10px 12px;"><strong>📌 Example Blog post image:</strong>&nbsp;</div><figure class="image"><img style="aspect-ratio:819/673;" src="/uploads/Blog2.jpg" width="819" height="673"></figure></li><li style="margin-bottom:12px;margin-right:0;margin-top:0;"><p style="margin-left:22px;"><strong>Read through comments:</strong><br>Scroll down and read the comments shared by other community members.</p></li><li style="margin-bottom:12px;margin-right:0;margin-top:0;"><p style="margin-left:22px;"><strong>Join the conversation:</strong></p><ul style="margin-bottom:0;margin-right:0;margin-top:8px;"><li><p style="margin-left:18px;">You can sort comments from <strong>Newest to Oldest</strong> (and vice versa).</p></li><li><p style="margin-left:18px;">You can read the reply from the Blog post creator.</p></li><li><p style="margin-left:18px;">Share how this comment made you feel using reaction emojis (🌿 ❤️ 😊).</p><figure class="image"><img style="aspect-ratio:1246/513;" src="/uploads/BlogComments.jpg" width="1246" height="513"></figure></li></ul></li><li style="margin-bottom:12px;margin-right:0;margin-top:0;"><p style="margin-left:22px;"><strong>Write your own comment:</strong></p><ul style="margin-bottom:0;margin-right:0;margin-top:8px;"><li><p style="margin-left:18px;">Enter your name</p></li><li><p style="margin-left:18px;">If you are the creator of this Blog post and want your comment to appear right away, please enter your email.&nbsp;</p></li><li><p style="margin-left:18px;">Write your comment</p></li></ul><div style="background-color:#fff7ed;border-radius:12px;border:1px solid #fdba74;margin:14px 0 0;padding:12px 14px;"><strong>⚠️ Important</strong><br>Any use or display of offensive, profane, or otherwise inappropriate language or images is strictly prohibited on the NWU website.</div><ul style="margin-bottom:0;margin-right:0;margin-top:8px;"><li><p style="margin-left:18px;">You can insert an image into your comment (optional)</p></li><li><p style="margin-left:18px;">To add multiple images, click the green button: <strong>“Show image upload tips” </strong>and read the instructions.</p><figure class="image"><img style="aspect-ratio:997/605;" src="/uploads/BlogCommentsAdd_XSS9UJ8.jpg" width="997" height="605"></figure></li><li><p style="margin-left:18px;">Click the <strong>Post Comment</strong> green button.</p><figure class="image"><img style="aspect-ratio:213/76;" src="/uploads/BlogPostCommentButton.jpg" width="213" height="76"></figure></li></ul></li></ol><div style="background-color:#ecfdf5;border-radius:12px;border:1px solid #86efac;margin:16px 0 10px;padding:12px 14px;"><strong>✅ You’re done!</strong><br>If you are the creator of this post and entered your email in the comment section, your comment will appear on this Blog post right away. Comments from other members are sent to the post creator (that’s you if you created this Blog post) for review. Once approved, those comments will be visible on the Blog.</div><p style="margin:14px 0 0;">🌿 Thank you for sharing your voice with kindness. Every thoughtful comment helps our NWU community grow - step by step, together!</p><p>&nbsp;</p>', "created_at" = '2026-01-07 18:33:31.458262', "updated_at" = '2026-01-19 21:37:21.911002' WHERE "core_nwu_manual"."id" = 34; args=('Step 6. Use the Blog on the NWU Website', 'step-5-use-blog-on-nwu-website', 'team', 6, '', '<p>Thank you for being part of <strong>Nordic Walking United</strong>! Our blog is a wonderful place to stay connected with our growing global NWU family and to keep learning together.</p><p style="margin:16px 0 8px;"><strong>Here, our event organizers and hosts share:</strong></p><ul style="margin-bottom:14px;margin-right:0;margin-top:0;"><li><p style="margin-left:22px;">🌍 Stories and highlights from their Nordic Walks</p></li><li><p style="margin-left:22px;">📸 Photos and special moments from events</p></li><li><p style="margin-left:22px;">💬 Reflections, ideas, and helpful tips</p></li><li><p style="margin-left:22px;">🌱 Inspiration from their local communities and nature</p></li><li><p style="margin-left:22px;">🧘\u200d♀️ Simple educational insights on movement, well-being, mindfulness, and healthy living</p></li></ul><p style="margin:16px 0 8px;"><strong>By reading and leaving comments, you:</strong></p><ul style="margin-bottom:14px;margin-right:0;margin-top:0;"><li><p style="margin-left:22px;">💛 Encourage and support fellow walkers and organizers</p></li><li><p style="margin-left:22px;">🤝 Build meaningful connections across regions and countries</p></li><li><p style="margin-left:22px;">🌟 Share your thoughts, experiences, and words of kindness</p></li><li><p style="margin-left:22px;">🌎 Help strengthen our welcoming, global NWU community</p></li></ul><p style="margin:0 0 16px;">Your voice matters, and every comment helps keep our community warm, supportive, and connected. We’re so happy you’re here!</p><hr style="border-bottom-style:none;border-left-style:none;border-right-style:none;border-top:1px solid #d1d5db;margin:18px 0;"><h3 style="font-size:22px;margin:0 0 10px;">Below are the steps to use our Blog section:</h3><ol style="margin-bottom:0;margin-right:0;margin-top:0;"><li style="margin-bottom:12px;margin-right:0;margin-top:0;"><p style="margin-left:22px;"><strong>Find our Blog section on the NWU website</strong><br>Open our Blog page by clicking <strong>Resources → Our Blog</strong> in the main menu.</p><figure class="image"><img style="aspect-ratio:1312/317;" src="/uploads/Blog1_r42bHkF.jpg" width="1312" height="317"></figure></li><li style="margin-bottom:12px;margin-right:0;margin-top:0;"><p style="margin-left:22px;"><strong>Read through Blog posts:</strong><br>Click on any post you would like to read.</p><div style="background-color:#f9fafb;border-radius:10px;border:1px dashed #9ca3af;margin:10px 0 0;padding:10px 12px;"><strong>📌 Example Blog post image:</strong>&nbsp;</div><figure class="image"><img style="aspect-ratio:819/673;" src="/uploads/Blog2.jpg" width="819" height="673"></figure></li><li style="margin-bottom:12px;margin-right:0;margin-top:0;"><p style="margin-left:22px;"><strong>Read through comments:</strong><br>Scroll down and read the comments shared by other community members.</p></li><li style="margin-bottom:12px;margin-right:0;margin-top:0;"><p style="margin-left:22px;"><strong>Join the conversation:</strong></p><ul style="margin-bottom:0;margin-right:0;margin-top:8px;"><li><p style="margin-left:18px;">You can sort comments from <strong>Newest to Oldest</strong> (and vice versa).</p></li><li><p style="margin-left:18px;">You can read the reply from the Blog post creator.</p></li><li><p style="margin-left:18px;">Share how this comment made you feel using reaction emojis (🌿 ❤️ 😊).</p><figure class="image"><img style="aspect-ratio:1246/513;" src="/uploads/BlogComments.jpg" width="1246" height="513"></figure></li></ul></li><li style="margin-bottom:12px;margin-right:0;margin-top:0;"><p style="margin-left:22px;"><strong>Write your own comment:</strong></p><ul style="margin-bottom:0;margin-right:0;margin-top:8px;"><li><p style="margin-left:18px;">Enter your name</p></li><li><p style="margin-left:18px;">If you are the creator of this Blog post and want your comment to appear right away, please enter your email.&nbsp;</p></li><li><p style="margin-left:18px;">Write your comment</p></li></ul><div style="background-color:#fff7ed;border-radius:12px;border:1px solid #fdba74;margin:14px 0 0;padding:12px 14px;"><strong>⚠️ Important</strong><br>Any use or display of offensive, profane, or otherwise inappropriate language or images is strictly prohibited on the NWU website.</div><ul style="margin-bottom:0;margin-right:0;margin-top:8px;"><li><p style="margin-left:18px;">You can insert an image into your comment (optional)</p></li><li><p style="margin-left:18px;">To add multiple images, click the green button: <strong>“Show image upload tips” </strong>and read the instructions.</p><figure class="image"><img style="aspect-ratio:997/605;" src="/uploads/BlogCommentsAdd_XSS9UJ8.jpg" width="997" height="605"></figure></li><li><p style="margin-left:18px;">Click the <strong>Post Comment</strong> green button.</p><figure class="image"><img style="aspect-ratio:213/76;" src="/uploads/BlogPostCommentButton.jpg" width="213" height="76"></figure></li></ul></li></ol><div style="background-color:#ecfdf5;border-radius:12px;border:1px solid #86efac;margin:16px 0 10px;padding:12px 14px;"><strong>✅ You’re done!</strong><br>If you are the creator of this post and entered your email in the comment section, your comment will appear on this Blog post right away. Comments from other members are sent to the post creator (that’s you if you created this Blog post) for review. Once approved, those comments will be visible on the Blog.</div><p style="margin:14px 0 0;">🌿 Thank you for sharing your voice with kindness. Every thoughtful comment helps our NWU community grow - step by step, together!</p><p>&nbsp;</p>', '2026-01-07 18:33:31.458262', '2026-01-19 21:37:21.911002', 34); alias=default
