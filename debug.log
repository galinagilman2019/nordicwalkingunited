(0.004) UPDATE "core_nwu_manual" SET "title" = 'Original. Create a Blog and Connect with the Entire NWU Community', "slug" = 'original-create-a-blog-and-connect-with-the-entire', "audience" = 'general', "order" = 2, "table_title" = '', "body" = '<div style="font-size:1.1em;line-height:1.7;"><h2 id="top">Step 5. Create a Blog and Connect with the Entire NWU Community</h2><p>A blog is a wonderful way to connect with your local and global Nordic Walking United community. Through blog posts, you can share photos, stories, and reflections from your events and inspire others 🌿🥾</p><div style="background-color:#f2f8ff;border:1px solid #cfe2ff;margin:18px 0;padding:14px 18px;"><p><strong>Quick Menu</strong></p><ul style="margin-bottom:0;margin-right:0;margin-top:10px;"><li><p style="margin-left:18px;"><a href="#step1">Step 1: Log in to the Admin Panel</a></p></li><li><p style="margin-left:18px;"><a href="#step2">Step 2: Open the Blog Section</a></p></li><li><p style="margin-left:18px;"><a href="#step3">Step 3: Create Your Blog Post</a></p></li><li><p style="margin-left:18px;"><a href="#step4">Step 4: Publish Your Blog</a></p></li><li><p style="margin-left:18px;"><a href="#step5">Step 5: Manage Comments</a></p></li><li><p style="margin-left:18px;"><a href="#step6">Step 6: Delete Your Blog Post</a></p></li></ul></div><hr><h3 id="step1">Step 1. Log in to the Admin Panel</h3><p>Go to:<br>Click the Admin Panel link provided in your Approval email.<br>Log in using your email and password.</p><figure class="image"><img style="aspect-ratio:372/336;" src="/uploads/AdminPanelLogin_cnhTuP7.jpg" width="372" height="336"></figure><p style="text-align:right;"><a href="#top">↑ Back to menu</a></p><h3 id="step2">Step 2. Open the Blog Section</h3><p style="margin:0 0 8px;">In the Admin Panel:</p><ul style="margin-bottom:16px;margin-right:0;margin-top:0;"><li><p style="margin-left:22px;">Go to <strong>Blog </strong>section</p></li><li><p style="margin-left:22px;">Click on <strong>Posts</strong></p></li><li><p style="margin-left:22px;">Click <strong>+ Add</strong> or <strong>Add Post +&nbsp;</strong></p><div class="nwu-imgph" style="background-color:#f2f2f2;border-radius:10px;margin:10px 0 14px 22px;padding:10px 12px;">Click any image below to enlarge (opens in a new tab):</div><figure class="image"><a href="/uploads/AdminPanelAddPost.jpg" target="_blank" rel="noopener noreferrer"><img style="aspect-ratio:1872/422;cursor:zoom-in;" src="/uploads/AdminPanelAddPost.jpg" alt="Admin Panel – Add Post" width="1872" height="422"></a></figure></li></ul><p style="text-align:right;"><a href="#top">↑ Back to menu</a></p><h3 id="step3">Step 3. Create Your Blog Post</h3><p style="margin:0 0 8px;">Now the fun part! 🎉</p><ul style="margin-bottom:16px;margin-right:0;margin-top:0;"><li><p style="margin-left:22px;">Enter the <strong>Title</strong> of your blog post</p></li><li><p style="margin-left:22px;">Write your text in the editor</p></li><li><p style="margin-left:22px;">Add photos directly into the text if you wish</p></li></ul><div style="background-color:#fff8cc;border-left:6px solid #f2c94c;margin:18px 0;padding:14px 16px;"><strong>Important:</strong> Images should be no more than <strong>700 × 700 px</strong>. Larger images may take up too much space in the blog section.</div><ul style="margin-bottom:16px;margin-right:0;margin-top:0;"><li><p style="margin-left:22px;">Use the editor tools to format your post and make it clear, welcoming, and beautiful</p></li></ul><div class="nwu-note" style="background-color:#fff7cc;border-radius:10px;margin:14px 0;padding:12px 14px;">Click the link to view detailed Text Editor instructions (opens in a new tab): <a href="https://www.nordicwalkingunited.org/en/tutorials/using-the-text-editor-while-creating-events-and-bl/" target="_blank" rel="noopener noreferrer">Using the Text Editor While Creating Events and Blogs&nbsp;</a></div><p style="text-align:right;"><a href="#top">↑ Back to menu</a></p><h3 id="step4">Step 4. Publish Your Blog</h3><p style="margin:0 0 10px;">When your post is ready:</p><ul style="margin-bottom:12px;margin-right:0;margin-top:0;"><li><p style="margin-left:22px;">✅ Check the <strong>“Is published”</strong> checkbox</p></li><li><p style="margin-left:22px;">Click the <strong>SAVE</strong> button (see above)</p></li></ul><figure class="image"><a href="/uploads/AdminPanelBlogWirtten.jpg" target="_blank" rel="noopener noreferrer"><img style="aspect-ratio:1020/813;cursor:zoom-in;" src="/uploads/AdminPanelBlogWirtten.jpg" alt="Admin Panel – Blog Written" width="1020" height="813"></a></figure><p style="background-color:#f2f7ff;border-left:5px solid #1e88e5;border-radius:10px;margin:0 0 18px;padding:12px 14px;">🎉 <strong>Great job!</strong> Your blog post is now live and visible to the entire NWU community. You can see your blog on NWU website: <a href="https://www.nordicwalkingunited.org/en/blog/" target="_blank" rel="noopener noreferrer">www.nordicwalkingunited.org/en/blog/&nbsp;</a></p><figure class="image"><a href="/uploads/AdminPanelBlogDeletePost.jpg" target="_blank" rel="noopener noreferrer"><img style="aspect-ratio:1312/317;cursor:zoom-in;" src="/uploads/Blog1_pP2wS9q.jpg" alt="Blog image" width="1312" height="317"></a></figure><figure class="image"><img style="aspect-ratio:819/673;" src="/uploads/Blog2_6tvZZur.jpg" width="819" height="673"></figure><p style="text-align:right;"><a href="#top">↑ Back to menu</a></p><h3 id="step5">Step 5. Manage Comments on Your Blog</h3><ul><li>Read comments from community members.</li><li>Reply to comments to encourage engagement.</li><li>Delete inappropriate comments if needed.</li></ul><p style="text-align:right;"><a href="#top">↑ Back to menu</a></p><h3 id="step6">Step 6. Delete Your Blog Post</h3><ol><li>Open the blog post in the Admin Panel.</li><li>Click <strong>Delete</strong>.</li><li>Confirm the deletion.</li></ol><p style="text-align:right;"><a href="#top">↑ Back to menu</a></p><div style="background-color:#f3fff1;border-left:6px solid #27ae60;margin:18px 0;padding:14px 16px;"><strong>NWU reminder:</strong> Blogs help preserve memories, build connection, and inspire others to join Nordic Walking 🌞</div></div><p>&nbsp;</p>', "created_at" = '2026-01-19 22:14:38.967517', "updated_at" = '2026-01-19 22:37:40.899039' WHERE "core_nwu_manual"."id" = 38; args=('Original. Create a Blog and Connect with the Entire NWU Community', 'original-create-a-blog-and-connect-with-the-entire', 'general', 2, '', '<div style="font-size:1.1em;line-height:1.7;"><h2 id="top">Step 5. Create a Blog and Connect with the Entire NWU Community</h2><p>A blog is a wonderful way to connect with your local and global Nordic Walking United community. Through blog posts, you can share photos, stories, and reflections from your events and inspire others 🌿🥾</p><div style="background-color:#f2f8ff;border:1px solid #cfe2ff;margin:18px 0;padding:14px 18px;"><p><strong>Quick Menu</strong></p><ul style="margin-bottom:0;margin-right:0;margin-top:10px;"><li><p style="margin-left:18px;"><a href="#step1">Step 1: Log in to the Admin Panel</a></p></li><li><p style="margin-left:18px;"><a href="#step2">Step 2: Open the Blog Section</a></p></li><li><p style="margin-left:18px;"><a href="#step3">Step 3: Create Your Blog Post</a></p></li><li><p style="margin-left:18px;"><a href="#step4">Step 4: Publish Your Blog</a></p></li><li><p style="margin-left:18px;"><a href="#step5">Step 5: Manage Comments</a></p></li><li><p style="margin-left:18px;"><a href="#step6">Step 6: Delete Your Blog Post</a></p></li></ul></div><hr><h3 id="step1">Step 1. Log in to the Admin Panel</h3><p>Go to:<br>Click the Admin Panel link provided in your Approval email.<br>Log in using your email and password.</p><figure class="image"><img style="aspect-ratio:372/336;" src="/uploads/AdminPanelLogin_cnhTuP7.jpg" width="372" height="336"></figure><p style="text-align:right;"><a href="#top">↑ Back to menu</a></p><h3 id="step2">Step 2. Open the Blog Section</h3><p style="margin:0 