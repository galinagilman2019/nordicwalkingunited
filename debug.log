(0.004) UPDATE "core_nwu_manual" SET "title" = 'Step 5. Create a Blog and Connect with the Entire NWU Community', "slug" = 'blog-a-great-way-to-connect-with-the-nwu-community', "audience" = 'team', "order" = 5, "table_title" = '', "body" = '<p>A blog is a wonderful way to stay connected with your local <strong>and</strong> global Nordic Walking United community. Through blog posts, you can:</p><ul style="margin-bottom:16px;margin-right:0;margin-top:0;"><li><p style="margin-left:22px;">📸 Share photos from your events</p></li><li><p style="margin-left:22px;">🚶 Tell the story of your walk</p></li><li><p style="margin-left:22px;">💬 Share feedback, reflections, and highlights</p></li><li><p style="margin-left:22px;">🌍 Inspire Nordic Walkers in other regions</p></li><li><p style="margin-left:22px;">✨ And much more</p></li></ul><p style="background-color:#f4fbf4;border-left:5px solid #2e7d32;border-radius:10px;margin:0 0 18px;padding:12px 14px;"><strong>Note:</strong> Only <strong>Event Organizers and Co-organizers </strong>can publish blog posts that are visible to the full NWU community.</p><hr style="margin:22px 0;"><h3 style="font-size:24px;margin:0 0 10px;">How to Write a Blog Post</h3><div style="background-color:#f6f7f9;border-radius:12px;margin:0 0 18px;padding:14px;"><p style="margin:0 0 10px;"><strong>Quick Menu</strong> (click to jump):</p><ul style="margin-bottom:0;margin-right:0;margin-top:0;"><li><p style="margin-left:22px;"><a href="#step1-login">Step 1: Log in to the Admin Panel</a></p></li><li><p style="margin-left:22px;"><a href="#step2-open-blog">Step 2: Open the Blog Section</a></p></li><li><p style="margin-left:22px;"><a href="#step3-create-post">Step 3: Create Your Blog Post</a></p></li><li><p style="margin-left:22px;"><a href="#step4-publish">Step 4: Publish Your Blog</a></p></li><li><p style="margin-left:22px;"><a href="#step5-comments">Step 5: Manage Comments on Your Blog</a></p></li><li><p style="margin-left:22px;"><a href="#step6-delete-post">Step 6: Delete Your Blog Post</a></p></li></ul></div><h3 style="font-size:24px;margin:0 0 8px;" id="step1-login">Step 1: Log in to the Admin Panel</h3><p style="margin:0 0 10px;">Click the Admin Panel link provided in your Approval email.</p><p style="margin:0 0 16px;">Log in using your email and password.</p><figure class="image"><img style="aspect-ratio:372/336;" src="/uploads/AdminPanelLogin.jpg" width="372" height="336"></figure><hr style="margin:22px 0;"><h3 style="font-size:24px;margin:0 0 8px;" id="step2-open-blog">Step 2: Open the Blog Section</h3><p style="margin:0 0 8px;">In the Admin Panel:</p><ul style="margin-bottom:16px;margin-right:0;margin-top:0;"><li><p style="margin-left:22px;">Go to <strong>Blog</strong></p></li><li><p style="margin-left:22px;">Click on <strong>Posts</strong></p></li><li><p style="margin-left:22px;">Click <strong>+ Add</strong> or <strong>Add Post +&nbsp;</strong></p><div class="nwu-imgph" style="background-color:#f2f2f2;border-radius:10px;margin:10px 0 14px 22px;padding:10px 12px;">Click any image below to enlarge (opens in a new tab):</div><figure class="image"><a href="/uploads/AdminPanelAddPost.jpg" target="_blank" rel="noopener noreferrer"><img style="aspect-ratio:1872/422;cursor:zoom-in;" src="/uploads/AdminPanelAddPost.jpg" alt="Admin Panel – Add Post" width="1872" height="422"></a></figure></li></ul><hr style="margin:22px 0;"><h3 style="font-size:24px;margin:0 0 8px;" id="step3-create-post">Step 3: Create Your Blog Post</h3><p style="margin:0 0 8px;">Now the fun part! 🎉</p><ul style="margin-bottom:16px;margin-right:0;margin-top:0;"><li><p style="margin-left:22px;">Enter the <strong>Title</strong> of your blog post</p></li><li><p style="margin-left:22px;">Write your text in the editor</p></li><li><p style="margin-left:22px;">Add photos directly into the text if you wish</p></li><li><p style="margin-left:22px;">Use the editor tools to format your post and make it clear, welcoming, and beautiful</p></li></ul><div class="nwu-note" style="background-color:#fff7cc;border-radius:10px;margin:14px 0;padding:12px 14px;">Click the link to view detailed Text Editor instructions (opens in a new tab): <a href="https://www.nordicwalkingunited.org/en/tutorials/using-the-text-editor-while-creating-events-and-bl/" target="_blank" rel="noopener noreferrer">Using the Text Editor While Creating Events and Blogs&nbsp;</a></div><hr style="margin:22px 0;"><h3 style="font-size:24px;margin:0 0 8px;" id="step4-publish">Step 4: Publish Your Blog Post</h3><p style="margin:0 0 10px;">When your post is ready:</p><ul style="margin-bottom:12px;margin-right:0;margin-top:0;"><li><p style="margin-left:22px;">✅ Check the <strong>“Is published”</strong> checkbox</p></li><li><p style="margin-left:22px;">Click the <strong>SAVE</strong> button (see above)</p></li></ul><figure class="image"><a href="/uploads/AdminPanelBlogWirtten.jpg" target="_blank" rel="noopener noreferrer"><img style="aspect-ratio:1020/813;cursor:zoom-in;" src="/uploads/AdminPanelBlogWirtten.jpg" alt="Admin Panel – Blog Written" width="1020" height="813"></a></figure><p style="background-color:#f2f7ff;border-left:5px solid #1e88e5;border-radius:10px;margin:0 0 18px;padding:12px 14px;">🎉 <strong>Great job!</strong> Your blog post is now live and visible to the entire NWU community. You can see your blog on NWU website:</p><figure class="image"><a href="/uploads/AdminPanelBlogDeletePost.jpg" target="_blank" rel="noopener noreferrer"><img style="aspect-ratio:1312/317;cursor:zoom-in;" src="/uploads/Blog1_pP2wS9q.jpg" alt="Blog image" width="1312" height="317"></a></figure><figure class="image"><img style="aspect-ratio:819/673;" src="/uploads/Blog2_6tvZZur.jpg" width="819" height="673"></figure>', "created_at" = '2026-01-04 21:48:28.851371', "updated_at" = '2026-01-19 21:45:47.638286' WHERE "core_nwu_manual"."id" = 31; args=('Step 5. Create a Blog and Connect with the Entire NWU Community', 'blog-a-great-way-to-connect-with-the-nwu-community', 'team', 5, '', '<p>A blog is a wonderful way to stay connected with your local <strong>and</strong> global Nordic Walking United community. Through blog posts, you can:</p><ul style="margin-bottom:16px;margin-right:0;margin-top:0;"><li><p style="margin-left:22px;">📸 Share photos from your events</p></li><li><p style="margin-left:22px;">🚶 Tell the story of your walk</p></li><li><p style="margin-left:22px;">💬 Share feedback, reflections, and highlights</p></li><li><p style="margin-left:22px;">🌍 Inspire Nordic Walkers in other regions</p></li><li><p style="margin-left:22px;">✨ And much more</p></li></ul><p style="background-color:#f4fbf4;border-left:5px solid #2e7d32;border-radius:10px;margin:0 0 18px;padding:12px 14px;"><strong>Note:</strong> Only <strong>Event Organizers and Co-organizers </strong>can publish blog posts that are visible to the full NWU community.</p><hr style="margin:22px 0;"><h3 style="font-size:24px;margin:0 0 10px;">How to Write a Blog Post</h3><div style="background-color:#f6f7f9;border-radius:12px;margin:0 0 18px;padding:14px;"><p style="margin:0 0 10px;"><strong>Quick Menu</strong> (click to jump):</p><ul style="margin-bottom:0;margin-right:0;margin-top:0;"><li><p style="margin-left:22px;"><a href="#step1-login">Step 1: Log in to the Admin Panel</a></p></li><li><p style="margin-left:22px;"><a href="#step2-open-blog">Step 2: Open the Blog Section</a></p></li><li><p style="margin-left:22px;"><a href="#step3-create-post">Step 3: Create Your Blog Post</a></p></li><li><p style="margin-left:22px;"><a href="#step4-publish">Step 4: Publish Your Blog</a></p></li><li><p style="margin-left:22px;"><a href="#step5-comments">Step 5: Manage Comments on Your Blog</a></p></li><li><p style="margin-left:22px;"><a href="#step6-delete-post">Step 6: Delete Your Blog Post</a></p></li></ul></div><h3 style="font-size:24px;margin:0 0 8px;" id="step1-login">Step 1: Log in to the Admin Panel</h3><p style="margin:0 0 10px;">Click the Admin Panel link provided in your Approval email.</p><p style="margin:0 0 16px;">Log in using your email and password.</p><figure class="image"><img style="aspect-ratio:372/336;" src="/uploads/AdminPanelLogin.jpg" width="372" height="336"></figure><hr style="margin:22px 0;"><h3 style="font-size:24px;margin:0 0 8px;" id="step2-open-blog">Step 2: Open the Blog Section</h3><p style="margin:0 0 8px;">In the Admin Panel:</p><ul style="margin-bottom:16px;margin-right:0;margin-top:0;"><li><p style="margin-left:22px;">Go to <strong>Blog</strong></p></li><li><p style="margin-left:22px;">Click on <strong>Posts</strong></p></li><li><p style="margin-left:22px;">Click <strong>+ Add</strong> or <strong>Add Post +&nbsp;</strong></p><div class="nwu-imgph" style="background-color:#f2f2f2;border-radius:10px;margin:10px 0 14px 22px;padding:10px 12px;">Click any image below to enlarge (opens in a new tab):</div><figure class="image"><a href="/uploads/AdminPanelAddPost.jpg" target="_blank" rel="noopener noreferrer"><img style="aspect-ratio:1872/422;cursor:zoom-in;" src="/uploads/AdminPanelAddPost.jpg" alt="Admin Panel – Add Post" width="1872" height="422"></a></figure></li></ul><hr style="margin:22px 0;"><h3 style="font-size:24px;margin:0 0 8px;" id="step3-create-post">Step 3: Create Your Blog Post</h3><p style="margin:0 0 8px;">Now the fun part! 🎉</p><ul style="margin-bottom:16px;margin-right:0;margin-top:0;"><li><p style="margin-left:22px;">Enter the <strong>Title</strong> of your blog post</p></li><li><p style="margin-left:22px;">Write your text in the editor</p></li><li><p style="margin-left:22px;">Add photos directly into the text if you wish</p></li><li><p style="margin-left:22px;">Use the editor tools to format your post and make it clear, welcoming, and beautiful</p></li></ul><div class="nwu-note" style="background-color:#fff7cc;border-radius:10px;margin:14px 0;padding:12px 14px;">Click the link to view detailed Text Editor instructions (opens in a new tab): <a href="https://www.nordicwalkingunited.org/en/tutorials/using-the-text-editor-while-creating-events-and-bl/" target="_blank" rel="noopener noreferrer">Using the Text Editor While Creating Events and Blogs&nbsp;</a></div><hr style="margin:22px 0;"><h3 style="font-size:24px;margin:0 0 8px;" id="step4-publish">Step 4: Publish Your Blog Post</h3><p style="margin:0 0 10px;">When your post is ready:</p><ul style="margin-bottom:12px;margin-right:0;margin-top:0;"><li><p style="margin-left:22px;">✅ Check the <strong>“Is published”</strong> checkbox</p></li><li><p style="margin-left:22px;">Click the <strong>SAVE</strong> button (see above)</p></li></ul><figure class="image"><a href="/uploads/AdminPanelBlogWirtten.jpg" target="_blank" rel="noopener noreferrer"><img style="aspect-ratio:1020/813;cursor:zoom-in;" src="/uploads/AdminPanelBlogWirtten.jpg" alt="Admin Panel – Blog Written" width="1020" height="813"></a></figure><p style="background-color:#f2f7ff;border-left:5px solid #1e88e5;border-radius:10px;margin:0 0 18px;padding:12px 14px;">🎉 <strong>Great job!</strong> Your blog post is now live and visible to the entire NWU community. You can see your blog on NWU website:</p><figure class="image"><a href="/uploads/AdminPanelBlogDeletePost.jpg" target="_blank" rel="noopener noreferrer"><img style="aspect-ratio:1312/317;cursor:zoom-in;" src="/uploads/Blog1_pP2wS9q.jpg" alt="Blog image" width="1312" height="317"></a></figure><figure class="image"><img style="aspect-ratio:819/673;" src="/uploads/Blog2_6tvZZur.jpg" width="819" height="673"></figure>', '2026-01-04 21:48:28.851371', '2026-01-19 21:45:47.638286', 31); alias=default
