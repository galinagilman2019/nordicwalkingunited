                                                                                                                                          border-left: 4px solid #f59e0b;
                                                                                                                                          background: #fffbeb;
                                                                                                                                          padding: 10px 12px;
                                                                                                                                          border-radius: 10px;
                                                                                                                                          margin: 12px 0;
                                                                                                                                        }
