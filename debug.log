(0.006) UPDATE "core_nwu_manual" SET "title" = 'Original. Create a Blog and Connect with the Entire NWU Community', "slug" = 'original-create-a-blog-and-connect-with-the-entire', "audience" = 'general', "order" = 2, "table_title" = '', "body" = '<div style="font-size:1.1em;line-height:1.7;"><h2 id="top">Step 5. Create a Blog and Connect with the Entire NWU Community</h2><p>A blog is a wonderful way to connect with your local and global Nordic Walking United community. Through blog posts, you can share photos, stories, and reflections from your events and inspire others 🌿🥾</p><div style="background-color:#f2f8ff;border:1px solid #cfe2ff;margin:18px 0;padding:14px 18px;"><p><strong>Quick Menu</strong></p><ul style="margin-bottom:0;margin-right:0;margin-top:10px;"><li><p style="margin-left:18px;"><a href="#step1">Step 1: Log in to the Admin Panel</a></p></li><li><p style="margin-left:18px;"><a href="#step2">Step 2: Open the Blog Section</a></p></li><li><p style="margin-left:18px;"><a href="#step3">Step 3: Create Your Blog Post</a></p></li><li><p style="margin-left:18px;"><a href="#step4">Step 4: Publish Your Blog</a></p></li><li><p style="margin-left:18px;"><a href="#step5">Step 5: Manage Comments</a></p></li><li><p style="margin-left:18px;"><a href="#step6">Step 6: Delete Your Blog Post</a></p></li></ul></div><hr><h3 id="step1">Step 1. Log in to the Admin Panel</h3><p>Go to:<br>Click the Admin Panel link provided in your Approval email.<br>Log in using your email and password.</p><figure class="image"><img style="aspect-ratio:372/336;" src="/uploads/AdminPanelLogin_cnhTuP7.jpg" width="372" height="336"></figure><p style="text-align:right;"><a href="#top">↑ Back to menu</a></p><h3 id="step2">Step 2. Open the Blog Section</h3><p>In the Admin Panel menu, click on <strong>Blogs</strong>. You will see a list of existing posts and an option to add a new one.</p><p style="text-align:right;"><a href="#top">↑ Back to menu</a></p><h3 id="step3">Step 3. Create Your Blog Post</h3><ol><li>Click <strong>Add Blog</strong> (or <strong>+ Add</strong>).</li><li>Enter a clear and welcoming <strong>Title</strong>.</li><li>Select the correct <strong>Group</strong>.</li><li>Write your blog content using the text editor.</li></ol><div style="background-color:#fff8cc;border-left:6px solid #f2c94c;margin:18px 0;padding:14px 16px;"><strong>Important:</strong> Images should be no more than <strong>700 × 700 px</strong>. Larger images may take up too much space in the blog section.</div><p style="text-align:right;"><a href="#top">↑ Back to menu</a></p><h3 id="step4">Step 4. Publish Your Blog</h3><ol><li>Review your post for clarity and layout.</li><li>Click <strong>Save</strong> or <strong>Publish</strong>.</li><li>Your blog will be visible to the entire NWU community.</li></ol><p style="text-align:right;"><a href="#top">↑ Back to menu</a></p><h3 id="step5">Step 5. Manage Comments on Your Blog</h3><ul><li>Read comments from community members.</li><li>Reply to comments to encourage engagement.</li><li>Delete inappropriate comments if needed.</li></ul><p style="text-align:right;"><a href="#top">↑ Back to menu</a></p><h3 id="step6">Step 6. Delete Your Blog Post</h3><ol><li>Open the blog post in the Admin Panel.</li><li>Click <strong>Delete</strong>.</li><li>Confirm the deletion.</li></ol><p style="text-align:right;"><a href="#top">↑ Back to menu</a></p><div style="background-color:#f3fff1;border-left:6px solid #27ae60;margin:18px 0;padding:14px 16px;"><strong>NWU reminder:</strong> Blogs help preserve memories, build connection, and inspire others to join Nordic Walking 🌞</div></div>', "created_at" = '2026-01-19 22:14:38.967517', "updated_at" = '2026-01-19 22:19:04.272155' WHERE "core_nwu_manual"."id" = 38; args=('Original. Create a Blog and Connect with the Entire NWU Community', 'original-create-a-blog-and-connect-with-the-entire', 'general', 2, '', '<div style="font-size:1.1em;line-height:1.7;"><h2 id="top">Step 5. Create a Blog and Connect with the Entire NWU Community</h2><p>A blog is a wonderful way to connect with your local and global Nordic Walking United community. Through blog posts, you can share photos, stories, and reflections from your events and inspire others 🌿🥾</p><div style="background-color:#f2f8ff;border:1px solid #cfe2ff;margin:18px 0;padding:14px 18px;"><p><strong>Quick Menu</strong></p><ul style="margin-bottom:0;margin-right:0;margin-top:10px;"><li><p style="margin-left:18px;"><a href="#step1">Step 1: Log in to the Admin Panel</a></p></li><li><p style="margin-left:18px;"><a href="#step2">Step 2: Open the Blog Section</a></p></li><li><p style="margin-left:18px;"><a href="#step3">Step 3: Create Your Blog Post</a></p></li><li><p style="margin-left:18px;"><a href="#step4">Step 4: Publish Your Blog</a></p></li><li><p style="margin-left:18px;"><a href="#step5">Step 5: Manage Comments</a></p></li><li><p style="margin-left:18px;"><a href="#step6">Step 6: Delete Your Blog Post</a></p></li></ul></div><hr><h3 id="step1">Step 1. Log in to the Admin Panel</h3><p>Go to:<br>Click the Admin Panel link provided in your Approval email.<br>Log in using your email and password.</p><figure class="image"><img style="aspect-ratio:372/336;" src="/uploads/AdminPanelLogin_cnhTuP7.jpg" width="372" height="336"></figure><p style="text-align:right;"><a href="#top">↑ Back to menu</a></p><h3 id="step2">Step 2. Open the Blog Section</h3><p>In the Admin Panel menu, click on <strong>Blogs</strong>. You will see a list of existing posts and an option to add a new one.</p><p style="text-align:right;"><a href="#top">↑ Back to menu</a></p><h3 id="step3">Step 3. Create Your Blog Post</h3><ol><li>Click <strong>Add Blog</strong> (or <strong>+ Add</strong>).</li><li>Enter a clear and welcoming <strong>Title</strong>.</li><li>Select the correct <strong>Group</strong>.</li><li>Write your blog content using the text editor.</li></ol><div style="background-color:#fff8cc;border-left:6px solid #f2c94c;margin:18px 0;padding:14px 16px;"><strong>Important:</strong> Images should be no more than <strong>700 × 700 px</strong>. Larger images may take up too much space in the blog section.</div><p style="text-align:right;"><a href="#top">↑ Back to menu</a></p><h3 id="step4">Step 4. Publish Your Blog</h3><ol><li>Review your post for clarity and layout.</li><li>Click <strong>Save</strong> or <strong>Publish</strong>.</li><li>Your blog will be visible to the entire NWU community.</li></ol><p style="text-align:right;"><a href="#top">↑ Back to menu</a></p><h3 id="step5">Step 5. Manage Comments on Your Blog</h3><ul><li>Read comments from community members.</li><li>Reply to comments to encourage engagement.</li><li>Delete inappropriate comments if needed.</li></ul><p style="text-align:right;"><a href="#top">↑ Back to menu</a></p><h3 id="step6">Step 6. Delete Your Blog Post</h3><ol><li>Open the blog post in the Admin Panel.</li><li>Click <strong>Delete</strong>.</li><li>Confirm the deletion.</li></ol><p style="text-align:right;"><a href="#top">↑ Back to menu</a></p><div style="background-color:#f3fff1;border-left:6px solid #27ae60;margin:18px 0;padding:14px 16px;"><strong>NWU reminder:</strong> Blogs help preserve memories, build connection, and inspire others to join Nordic Walking 🌞</div></div>', '2026-01-19 22:14:38.967517', '2026-01-19 22:19:04.272155', 38); alias=default
