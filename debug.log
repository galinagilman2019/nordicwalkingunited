django.template.base.VariableDoesNotExist: Failed lookup for key [errors] in [{'True': True, 'False': False, 'None': None}, {'widget': {'name': 'body', 'is_hidden': False, 'required': False, 'value': '<section><p>Before starting your Nordic Walking session, take 3–5 minutes to warm up your muscles and joints. Perform each exercise for <strong>20–30 seconds</strong> per side (where applicable) with smooth, controlled motion.</p><ol><li><h3>Neck Rotations</h3><p>Stand tall. Gently rotate your head in a slow circle clockwise, then counterclockwise. Keep shoulders relaxed.</p></li><li><h3>Arm Circles</h3><p>Feet shoulder-width apart, arms extended at shoulder height. Make small circles, gradually increasing the size. Reverse direction halfway.</p></li><li><h3>Shoulder Rolls</h3><p>Lift shoulders toward ears, roll back and down. Repeat, then switch to forward rolls.</p></li><li><h3>Torso Twists</h3><p>Feet hip-width apart, soft knees. Gently twist your upper body side-to-side, letting arms swing loosely.</p></li><li><h3>Hip Circles</h3><p>Hands on hips. Draw wide circles with your hips clockwise, then counterclockwise to mobilize the hip joints.</p></li><li><h3>Knee Lifts (March in Place)</h3><p>March in place, lifting knees toward chest. Keep posture tall and engage your core.</p></li><li><h3>Ankle Rotations</h3><p>Standing or seated, lift one foot and rotate the ankle both directions. Switch sides.</p></li><li><h3>Calf Stretch</h3><p>Step one foot back, heel down, knee straight. Lean forward to stretch the back calf. Switch sides.</p><figure class="image"><img style="aspect-ratio:473/395;" src="/uploads/CalfStretch.jpg" width="473" height="395"></figure></li><li><h3>Hamstring Stretch</h3><p>Extend one leg forward with heel on the ground and toes up. Hinge slightly at the hips, keeping back long. Switch sides.</p></li><li><h3>Quad Stretch</h3><p>Stand tall (hold a pole or wall for balance). Bend one knee and draw heel toward glutes, knees together. Switch sides.</p></li></ol><aside><h4>Tips</h4><ul><li>Breathe naturally—never hold your breath.</li><li>Move within a comfortable, pain-free range.</li><li>Use your poles or a wall for balance as needed.</li></ul></aside></section>', 'attrs': {'class': 'django_ckeditor_5', 'id': 'id_body'}, 'template_name': 'django_ckeditor_5/widget.html'}, 'config': {'toolbar': ['heading', 'codeBlock', '|', 'outdent', 'indent', '|', 'bold', 'italic', 'link', 'underline', 'strikethrough', 'code', 'subscript', 'superscript', 'highlight', '|', 'bulletedList', 'numberedList', 'todoList', '|', 'blockQuote', 'insertImage', '|', 'fontSize', 'fontFamily', 'fontColor', 'fontBackgroundColor', 'mediaEmbed', 'removeFormat', 'insertTable', 'sourceEditing'], 'language': 'en', 'blockToolbar': ['paragraph', 'heading1', 'heading2', 'heading3', '|', 'bulletedList', 'numberedList', '|', 'blockQuote'], 'image': {'toolbar': ['imageTextAlternative', '|', 'imageStyle:alignLeft', 'imageStyle:alignRight', 'imageStyle:alignCenter', 'imageStyle:side', '|', 'toggleImageCaption', '|'], 'styles': ['full', 'side', 'alignLeft', 'alignRight', 'alignCenter']}, 'table': {'contentToolbar': ['tableColumn', 'tableRow', 'mergeTableCells', 'tableProperties', 'tableCellProperties'], 'tableProperties': {'borderColors': [{'color': 'hsl(4, 90%, 58%)', 'label': 'Red'}, {'color': 'hsl(340, 82%, 52%)', 'label': 'Pink'}, {'color': 'hsl(291, 64%, 42%)', 'label': 'Purple'}, {'color': 'hsl(262, 52%, 47%)', 'label': 'Deep Purple'}, {'color': 'hsl(231, 48%, 48%)', 'label': 'Indigo'}, {'color': 'hsl(207, 90%, 54%)', 'label': 'Blue'}], 'backgroundColors': [{'color': 'hsl(4, 90%, 58%)', 'label': 'Red'}, {'color': 'hsl(340, 82%, 52%)', 'label': 'Pink'}, {'color': 'hsl(291, 64%, 42%)', 'label': 'Purple'}, {'color': 'hsl(262, 52%, 47%)', 'label': 'Deep Purple'}, {'color': 'hsl(231, 48%, 48%)', 'label': 'Indigo'}, {'color': 'hsl(207, 90%, 54%)', 'label': 'Blue'}]}, 'tableCellProperties': {'borderColors': [{'color': 'hsl(4, 90%, 58%)', 'label': 'Red'}, {'color'