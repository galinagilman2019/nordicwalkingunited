(0.004) UPDATE "core_nwu_manual" SET "title" = 'Step 7. Communicate with your Event members', "slug" = 'step-4-communicate-with-your-event-members', "audience" = 'team', "order" = 7, "table_title" = '', "body" = '<p>Sharing comments helps you stay connected with all event members, share important information, and ask or answer questions. Here’s how it works:</p><h4>Open the Event on NWU website.</h4><figure class="image"><img style="aspect-ratio:1355/522;" src="/uploads/FindEvent.jpg" width="1355" height="522"></figure><ol><li>Find and click on your <strong>event</strong>.</li><li><strong>Log in</strong> to your account.</li><li><strong>Sign up</strong> for the event (this step is required to comment).</li></ol><h4>View Existing Comments</h4><ul><li>In the event window, click <strong>"Show all comments"</strong>, or click the <strong>total number of participants</strong> link to see all comments.</li></ul><p><i>Note: When comments are shown, the event description will be moved to the bottom of the Event page. You can scroll down to see it.</i></p><figure class="image"><img style="aspect-ratio:1188/597;" src="/uploads/EventPageShowAllComments.jpg" width="1188" height="597"></figure><ul><li><p>Click <strong>"Hide all comments"</strong> if you want to hide comments and see only the event description.</p><figure class="image"><img style="aspect-ratio:1212/704;" src="/uploads/EventPageHideAllComments_kx9rZzV.jpg" width="1212" height="704"></figure></li></ul><h4>View Comments by a Specific User</h4><ul><li><p>To see a comment from a particular user, click on their <strong>avatar</strong>.</p><figure class="image"><img style="aspect-ratio:1188/597;" src="/uploads/EventPageReadParticipantOnlyComment.jpg" width="1188" height="597"></figure></li><li>To see all comments again, click the <strong>total number of participants</strong> link.</li></ul><h4>Write Your Own Comment</h4><ol><li><p>Click the green <strong>"Write comment"</strong> button.</p><figure class="image"><img style="aspect-ratio:1188/597;" src="/uploads/EventPageWriteComment.jpg" width="1188" height="597"></figure></li><li>Write your comment in the text box.</li><li>If you want, upload an image in <strong>JPG</strong>, <strong>JPEG</strong>, or <strong>PNG</strong> format.</li><li><p>Submit your comment - and you’re done!</p><figure class="image"><img style="aspect-ratio:1192/450;" src="/uploads/EventCommentsSubmit.jpg" width="1192" height="450"></figure></li></ol><p><strong>Enjoy connecting with fellow walkers by asking and answering questions, sharing photos, and exchanging event details. </strong>🌿</p><p>&nbsp;</p>', "created_at" = '2026-01-03 22:11:11.404583', "updated_at" = '2026-01-19 21:36:11.633469' WHERE "core_nwu_manual"."id" = 30; args=('Step 7. Communicate with your Event members', 'step-4-communicate-with-your-event-members', 'team', 7, '', '<p>Sharing comments helps you stay connected with all event members, share important information, and ask or answer questions. Here’s how it works:</p><h4>Open the Event on NWU website.</h4><figure class="image"><img style="aspect-ratio:1355/522;" src="/uploads/FindEvent.jpg" width="1355" height="522"></figure><ol><li>Find and click on your <strong>event</strong>.</li><li><strong>Log in</strong> to your account.</li><li><strong>Sign up</strong> for the event (this step is required to comment).</li></ol><h4>View Existing Comments</h4><ul><li>In the event window, click <strong>"Show all comments"</strong>, or click the <strong>total number of participants</strong> link to see all comments.</li></ul><p><i>Note: When comments are shown, the event description will be moved to the bottom of the Event page. You can scroll down to see it.</i></p><figure class="image"><img style="aspect-ratio:1188/597;" src="/uploads/EventPageShowAllComments.jpg" width="1188" height="597"></figure><ul><li><p>Click <strong>"Hide all comments"</strong> if you want to hide comments and see only the event description.</p><figure class="image"><img style="aspect-ratio:1212/704;" src="/uploads/EventPageHideAllComments_kx9rZzV.jpg" width="1212" height="704"></figure></li></ul><h4>View Comments by a Specific User</h4><ul><li><p>To see a comment from a particular user, click on their <strong>avatar</strong>.</p><figure class="image"><img style="aspect-ratio:1188/597;" src="/uploads/EventPageReadParticipantOnlyComment.jpg" width="1188" height="597"></figure></li><li>To see all comments again, click the <strong>total number of participants</strong> link.</li></ul><h4>Write Your Own Comment</h4><ol><li><p>Click the green <strong>"Write comment"</strong> button.</p><figure class="image"><img style="aspect-ratio:1188/597;" src="/uploads/EventPageWriteComment.jpg" width="1188" height="597"></figure></li><li>Write your comment in the text box.</li><li>If you want, upload an image in <strong>JPG</strong>, <strong>JPEG</strong>, or <strong>PNG</strong> format.</li><li><p>Submit your comment - and you’re done!</p><figure class="image"><img style="aspect-ratio:1192/450;" src="/uploads/EventCommentsSubmit.jpg" width="1192" height="450"></figure></li></ol><p><strong>Enjoy connecting with fellow walkers by asking and answering questions, sharing photos, and exchanging event details. </strong>🌿</p><p>&nbsp;</p>', '2026-01-03 22:11:11.404583', '2026-01-19 21:36:11.633469', 30); alias=default
