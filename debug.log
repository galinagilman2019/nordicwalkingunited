(0.005) UPDATE "core_event" SET "name" = 'South Shore Nordic Walkers Pembroke', "date" = '2026-02-20', "city" = 'Pembroke', "country" = 'US', "nwgroup" = 'South Shore Nordic Walkers', "preview" = '<div class="xdj266r x14z9mp xat24cr x1lziwak x1vvkbs" style="-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);color:rgb(8, 8, 9);font-family:&quot;Segoe UI Historic&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;font-size:15px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;letter-spacing:normal;margin-bottom:0px;margin-inline:0px;margin-top:0px;orphans:2;overflow-wrap:break-word;text-align:start;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;">Dear NWU Team,</div><div class="x14z9mp xat24cr x1lziwak x1vvkbs xtlvy1s" style="-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);color:rgb(8, 8, 9);font-family:&quot;Segoe UI Historic&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;font-size:15px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;letter-spacing:normal;margin-bottom:0px;margin-inline:0px;margin-top:0.5em;orphans:2;overflow-wrap:break-word;text-align:start;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;">If Saturday brings a light sprinkle, let it add a little magic to our walk along the peaceful, beautiful, easy, and flat trails of Tubbs Meadow. Please wear comfortable, multi-layered clothing and waterproof shoes. And of course, don’t forget your favorite mug for my cozy, rejuvenating NWU herbal tea!</div><div class="x14z9mp xat24cr x1lziwak x1vvkbs xtlvy1s" style="-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);color:rgb(8, 8, 9);font-family:&quot;Segoe UI Historic&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;font-size:15px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;letter-spacing:normal;margin-bottom:0px;margin-inline:0px;margin-top:0.5em;orphans:2;overflow-wrap:break-word;text-align:start;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;">As many of you know, I come from Latvia, a small European country where people walk with poles year-round—rain, sun, wind, or snow! Nordic walking is beloved across Europe because it engages 90% of the body’s muscles, improves posture, and increases oxygen intake by 23% more than other sports.<br>Now everyone in our communities can enjoy these same benefits:<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t51/1/16/2714.png" alt="✔️" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Fun and accessible for almost anyone<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t51/1/16/2714.png" alt="✔️" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Supports weight loss and tones muscles<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t51/1/16/2714.png" alt="✔️" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Strengthens bones and protects joints<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t51/1/16/2714.png" alt="✔️" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Boosts heart and lung function (especially helpful for asthma)<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t51/1/16/2714.png" alt="✔️" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Enhances circulation and lymph drainage<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t51/1/16/2714.png" alt="✔️" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Improves mental well-being<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t51/1/16/2714.png" alt="✔️" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> And gives us the joy of discovering beautiful new places around us.</div><div class="x14z9mp xat24cr x1lziwak x1vvkbs xtlvy1s" style="-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);color:rgb(8, 8, 9);font-family:&quot;Segoe UI Historic&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;font-size:15px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;letter-spacing:normal;margin-bottom:0px;margin-inline:0px;margin-top:0.5em;orphans:2;overflow-wrap:break-word;text-align:start;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;">Important Notice:<br>By joining this event, you waive any claim of liability against the instructors, administrators, hosts, and members of Nordic Walking United and hold them blameless in case of any adverse experience during the activity.</div><div class="x14z9mp xat24cr x1lziwak x1vvkbs xtlvy1s" style="-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);color:rgb(8, 8, 9);font-family:&quot;Segoe UI Historic&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;font-size:15px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;letter-spacing:normal;margin-bottom:0px;margin-inline:0px;margin-top:0.5em;orphans:2;overflow-wrap:break-word;text-align:start;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;">Newcomers Welcome!<br>I warmly invite you and your friends to give Nordic Walking a try. Every newcomer will receive a free introductory lesson and is encouraged to walk at their own pace.<br>I also have two extra sets of poles available for the introductory walk. If you’d like to reserve a pair, just send me a message.</div><div class="x14z9mp xat24cr x1lziwak x1vvkbs xtlvy1s" style="-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);color:rgb(8, 8, 9);font-family:&quot;Segoe UI Historic&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;font-size:15px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;letter-spacing:normal;margin-bottom:0px;margin-inline:0px;margin-top:0.5em;orphans:2;overflow-wrap:break-word;text-align:start;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;">Our practice includes:<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t7a/1/16/31_20e3.png" alt="1️⃣" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Warm-up exercises<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t99/1/16/32_20e3.png" alt="2️⃣" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Nordic walk (approx. 2–4 miles, 1–1.5 hours)<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/tb8/1/16/33_20e3.png" alt="3️⃣" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Cool-down stretching<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/td7/1/16/34_20e3.png" alt="4️⃣" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Tea time!</div><div class="x14z9mp xat24cr x1lziwak x1vvkbs xtlvy1s" style="-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);color:rgb(8, 8, 9);font-family:&quot;Segoe UI Historic&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;font-size:15px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;letter-spacing:normal;margin-bottom:0px;margin-inline:0px;margin-top:0.5em;orphans:2;overflow-wrap:break-word;text-align:start;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;"><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t6c/1/16/1f499.png" alt="💙" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> I believe that one cannot separate the health of the individual from the health of the community.</div><div class="x14z9mp xat24cr x1lziwak x1vvkbs xtlvy1s" style="-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);color:rgb(8, 8, 9);font-family:&quot;Segoe UI Historic&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;font-size:15px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;letter-spacing:normal;margin-bottom:0px;margin-inline:0px;margin-top:0.5em;orphans:2;overflow-wrap:break-word;text-align:start;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;">Looking forward to seeing you all,<br>Ksenya</div><figure class="image"><img style="aspect-ratio:4537/3264;" src="/uploads/IMG_3456%20(1).jpg" width="4537" height="3264"></figure>', "start_time" = '10:00AM', "duration" = '1.5 hours', "difficulty" = 0, "unit" = 0, "distance" = 3.5, "latlng" = '42.04266979704184, -70.8100496', "photo" = 'event/cities/IMG_3453.jpg', "photo_credit" = NULL, "photo_link" = NULL, "email" = 'pembroke@djangogirls.org', "main_organizer_id" = 30, "is_on_homepage" = 1, "is_deleted" = 0, "created_at" = '2026-01-18 20:07:46.655174', "page_title" = 'South Shore Nordic Walkers Pembroke', "page_description" = 'Nordic Walk United is a one-day event in Nordic Walk United.', "page_main_color" = 'FF9400', "page_custom_css" = '', "page_url" = 'pembroke', "is_page_live" = 1, "is_frozen" = 0, "attendees_count" = NULL, "applicants_count" = NULL, "uuuid" = 'eea47ede87c748059d531f59b30da14b', "thank_you_email_sent" = NULL, "submit_information_email_sent" = NULL, "offer_help_email_sent" = NULL WHERE "core_event"."id" = 122; args=('South Shore Nordic Walkers Pembroke', '2026-02-20', 'Pembroke', 'US', 'South Shore Nordic Walkers', '<div class="xdj266r x14z9mp xat24cr x1lziwak x1vvkbs" style="-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);color:rgb(8, 8, 9);font-family:&quot;Segoe UI Historic&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;font-size:15px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;letter-spacing:normal;margin-bottom:0px;margin-inline:0px;margin-top:0px;orphans:2;overflow-wrap:break-word;text-align:start;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;">Dear NWU Team,</div><div class="x14z9mp xat24cr x1lziwak x1vvkbs xtlvy1s" style="-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);color:rgb(8, 8, 9);font-family:&quot;Segoe UI Historic&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;font-size:15px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;letter-spacing:normal;margin-bottom:0px;margin-inline:0px;margin-top:0.5em;orphans:2;overflow-wrap:break-word;text-align:start;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;">If Saturday brings a light sprinkle, let it add a little magic to our walk along the peaceful, beautiful, easy, and flat trails of Tubbs Meadow. Please wear comfortable, multi-layered clothing and waterproof shoes. And of course, don’t forget your favorite mug for my cozy, rejuvenating NWU herbal tea!</div><div class="x14z9mp xat24cr x1lziwak x1vvkbs xtlvy1s" style="-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);color:rgb(8, 8, 9);font-family:&quot;Segoe UI Historic&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;font-size:15px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;letter-spacing:normal;margin-bottom:0px;margin-inline:0px;margin-top:0.5em;orphans:2;overflow-wrap:break-word;text-align:start;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;">As many of you know, I come from Latvia, a small European country where people walk with poles year-round—rain, sun, wind, or snow! Nordic walking is beloved across Europe because it engages 90% of the body’s muscles, improves posture, and increases oxygen intake by 23% more than other sports.<br>Now everyone in our communities can enjoy these same benefits:<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t51/1/16/2714.png" alt="✔️" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Fun and accessible for almost anyone<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t51/1/16/2714.png" alt="✔️" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Supports weight loss and tones muscles<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t51/1/16/2714.png" alt="✔️" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Strengthens bones and protects joints<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t51/1/16/2714.png" alt="✔️" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Boosts heart and lung function (especially helpful for asthma)<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t51/1/16/2714.png" alt="✔️" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Enhances circulation and lymph drainage<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t51/1/16/2714.png" alt="✔️" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Improves mental well-being<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t51/1/16/2714.png" alt="✔️" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> And gives us the joy of discovering beautiful new places around us.</div><div class="x14z9mp xat24cr x1lziwak x1vvkbs xtlvy1s" style="-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);color:rgb(8, 8, 9);font-family:&quot;Segoe UI Historic&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;font-size:15px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;letter-spacing:normal;margin-bottom:0px;margin-inline:0px;margin-top:0.5em;orphans:2;overflow-wrap:break-word;text-align:start;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;">Important Notice:<br>By joining this event, you waive any claim of liability against the instructors, administrators, hosts, and members of Nordic Walking United and hold them blameless in case of any adverse experience during the activity.</div><div class="x14z9mp xat24cr x1lziwak x1vvkbs xtlvy1s" style="-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);color:rgb(8, 8, 9);font-family:&quot;Segoe UI Historic&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;font-size:15px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;letter-spacing:normal;margin-bottom:0px;margin-inline:0px;margin-top:0.5em;orphans:2;overflow-wrap:break-word;text-align:start;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;">Newcomers Welcome!<br>I warmly invite you and your friends to give Nordic Walking a try. Every newcomer will receive a free introductory lesson and is encouraged to walk at their own pace.<br>I also have two extra sets of poles available for the introductory walk. If you’d like to reserve a pair, just send me a message.</div><div class="x14z9mp xat24cr x1lziwak x1vvkbs xtlvy1s" style="-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);color:rgb(8, 8, 9);font-family:&quot;Segoe UI Historic&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;font-size:15px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;letter-spacing:normal;margin-bottom:0px;margin-inline:0px;margin-top:0.5em;orphans:2;overflow-wrap:break-word;text-align:start;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;">Our practice includes:<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t7a/1/16/31_20e3.png" alt="1️⃣" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Warm-up exercises<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t99/1/16/32_20e3.png" alt="2️⃣" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Nordic walk (approx. 2–4 miles, 1–1.5 hours)<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/tb8/1/16/33_20e3.png" alt="3️⃣" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Cool-down stretching<br><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/td7/1/16/34_20e3.png" alt="4️⃣" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> Tea time!</div><div class="x14z9mp xat24cr x1lziwak x1vvkbs xtlvy1s" style="-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);color:rgb(8, 8, 9);font-family:&quot;Segoe UI Historic&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;font-size:15px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;letter-spacing:normal;margin-bottom:0px;margin-inline:0px;margin-top:0.5em;orphans:2;overflow-wrap:break-word;text-align:start;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;"><span class="html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od" style="display:inline-flex;font-family:inherit;font-style:normal;font-weight:400;height:16px;margin-bottom:0px;margin-inline:1px;margin-top:0px;overflow-wrap:break-word;padding-bottom:0px;padding-inline:0px;padding-top:0px;text-align:inherit;text-decoration:none;vertical-align:middle;width:16px;"><img class="xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw" style="border-end-end-radius:0px;border-end-start-radius:0px;border-start-end-radius:0px;border-start-start-radius:0px;border-width:0px;object-fit:fill;" src="https://static.xx.fbcdn.net/images/emoji.php/v9/t6c/1/16/1f499.png" alt="💙" width="16" height="16" referrerpolicy="origin-when-cross-origin"></span> I believe that one cannot separate the health of the individual from the health of the community.</div><div class="x14z9mp xat24cr x1lziwak x1vvkbs xtlvy1s" style="-webkit-text-stroke-width:0px;background-color:rgb(255, 255, 255);color:rgb(8, 8, 9);font-family:&quot;Segoe UI Historic&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;font-size:15px;font-style:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-weight:400;letter-spacing:normal;margin-bottom:0px;margin-inline:0px;margin-top:0.5em;orphans:2;overflow-wrap:break-word;text-align:start;text-decoration-color:initial;text-decoration-style:initial;text-decoration-thickness:initial;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;">Looking forward to seeing you all,<br>Ksenya</div><figure class="image"><img style="aspect-ratio:4537/3264;" src="/uploads/IMG_3456%20(1).jpg" width="4537" height="3264"></figure>', '10:00AM', '1.5 hours', 0, 0, 3.5, '42.04266979704184, -70.8100496', 'event/cities/IMG_3453.jpg', 'pembroke@djangogirls.org', 30, True, False, '2026-01-18 20:07:46.655174', 'South Shore Nordic Walkers Pembroke', 'Nordic Walk United is a one-day event in Nordic Walk United.', 'FF9400', '', 'pembroke', True, False, 'eea47ede87c748059d531f59b30da14b', 122); alias=default
