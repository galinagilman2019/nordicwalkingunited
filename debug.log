</p>', '', 5, 1); args=[123, 'partners', '\n\n<h3>Sponsors</h3>\n\n<p>\n    \n    We couldn\'t be here without the support from amazing people and organizations who donated money, knowledge and time to help us make this a reality. If you want to contribute and support our goal, <a href="">please get it touch</a>\n</p>', '', 5, True]; alias=default
(0.000) INSERT INTO "core_eventpagecontent" ("event_id", "name", "content", "background", "position", "is_public") VALUES (123, 'footer', '

<div class="container">
